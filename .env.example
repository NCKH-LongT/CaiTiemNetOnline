NETVERSE_HTTP_PORT=18473
POSTGRES_PASSWORD=replace-with-long-random-url-safe-password
IMAGE_TAG=local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-long-random-admin-password
# Official Cloudflare Turnstile test keys for local development only.
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: enables AI arrangement in the admin editor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: YouTube Data API v3 key for keyword search inside PC browser.
YOUTUBE_API_KEY=
COOKIE_SECURE=false
# Optional TURN relay for voice across strict NAT/mobile networks. Configure coturn use-auth-secret with the same secret.
VOICE_TURN_URL=
VOICE_TURN_SECRET=
# Optional Google OAuth 2.0 credentials for automatic image backup to a Drive folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
